FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgcc-s1 \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/wallet-api-entrypoint.sh /usr/local/bin/wallet-api-entrypoint.sh

EXPOSE 1337

ENTRYPOINT ["sh", "/usr/local/bin/wallet-api-entrypoint.sh"]
